# ==============================================================================
# Zoho Analytics MCP Server - Development Environment Variables
# ==============================================================================
# 
# Instructions:
# 1. Copy this file and rename it to '.env' in the same directory
# 2. Fill in your actual values (remove the placeholder comments)
# 3. Start the Docker container: docker-compose -f docker-compose.node_dev_env.yaml up -d
# 4. The environment variables will be automatically available in the container shell
#
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED Environment Variables
# ------------------------------------------------------------------------------
# These are mandatory for the MCP server to function

# Your Zoho Analytics OAuth client ID
ANALYTICS_CLIENT_ID=your_client_id_here

# Your Zoho Analytics OAuth client secret
ANALYTICS_CLIENT_SECRET=your_client_secret_here

# Your Zoho Analytics OAuth refresh token
ANALYTICS_REFRESH_TOKEN=your_refresh_token_here

# Your Zoho Analytics organization ID
ANALYTICS_ORG_ID=your_org_id_here

# Your Zoho Accounts Domain URL (e.g., https://accounts.zoho.com or https://accounts.zoho.eu)
ACCOUNTS_SERVER_URL=https://accounts.zoho.com

# Your Zoho Analytics API Domain URL (e.g., https://analyticsapi.zoho.com or https://analyticsapi.zoho.eu)
ANALYTICS_SERVER_URL=https://analyticsapi.zoho.com

# ------------------------------------------------------------------------------
# OPTIONAL Environment Variables
# ------------------------------------------------------------------------------
# These have default values but can be customized

# Directory for storing temporary data files (default: system temp directory)
# In the container, you might want to use /tmp or /app/tmp
ANALYTICS_MCP_DATA_DIR=/tmp

# Root directory for file operations (required for import_data and export_view tools)
# This should be set to ensure file operations are restricted to a specific directory
ALLOWED_FILE_ROOT=/app

# Maximum number of rows returned by the query_data tool (default: 20, max: 1000)
QUERY_DATA_RESULT_ROW_LIMITS=20

# Interval (in seconds) between job status polls (default: 4)
QUERY_DATA_POLLING_INTERVAL=4

# Maximum time (in seconds) a job can remain in queue (default: 120)
QUERY_DATA_QUEUE_TIMEOUT=120

# Maximum query execution time in seconds (default: 30)
QUERY_DATA_QUERY_EXECUTION_TIMEOUT=30

# Maximum number of workspaces returned by get_workspaces (default: 20)
WORKSPACE_RESULT_LIMIT=20

# Maximum number of views returned by get_views (default: 30)
VIEW_RESULT_LIMIT=30

# ------------------------------------------------------------------------------
# DEBUGGING Environment Variables (Optional)
# ------------------------------------------------------------------------------
# Uncomment these if you want to enable debugging by default in the container

# Enable debugging mode (set to "true" to enable)
# DEBUG=true

# Debug port for remote debugging (default: 9229)
# DEBUG_PORT=9229
