{
  "name": "zoho-analytics-mcp-server",
  "version": "1.0.8",
  "description": "MCP server implementation for Zoho Analytics",
  "bin": {
    "zoho-analytics-mcp-server": "./dist/src/index.js"
  },
  "scripts": {
    "prebuild": "PRODUCT_NAME='Zoho Analytics' node scripts/generate-package-json.js",
    "prebuild:meap": "PRODUCT_NAME='Analytics Plus Cloud' node scripts/generate-package-json.js",
    "prebuild:zaop": "PRODUCT_NAME='Zoho Analytics On-Premise' node scripts/generate-package-json.js",
    "prebuild:meapop": "PRODUCT_NAME='Analytics Plus On-Premise' node scripts/generate-package-json.js",
    "build": "PRODUCT_NAME='Zoho Analytics' node scripts/build.mjs",
    "build:meap": "PRODUCT_NAME='Analytics Plus Cloud' node scripts/build.mjs",
    "build:zaop": "PRODUCT_NAME='Zoho Analytics On-Premise' node scripts/build.mjs",
    "build:meapop": "PRODUCT_NAME='Analytics Plus On-Premise' node scripts/build.mjs",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "24.0.3",
    "jest": "29.7.0",
    "nodemon": "3.1.10",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "csv-parser": "3.2.0",
    "dedent": "1.6.0",
    "dotenv": "17.0.1",
    "form-data": "4.0.6"
  },
  "files": [
    "dist"
  ]
}
